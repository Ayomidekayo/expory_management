generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  role     Role    @default(STAFF)
  isActive Boolean @default(true)

  // Profile
  phone      String?
  department String?
  jobTitle   String?
  avatar     String?

  shipments Shipment[]

  createdAllocations  Allocation[] @relation("CreatedAllocations")
  assignedAllocations Allocation[] @relation("AssignedAllocations")
  approvedAllocations Allocation[] @relation("ApprovedAllocations")
  uploadedDocuments   AllocationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AllocationDocument {
  id           String       @id @default(cuid())

  allocationId String

  type         DocumentType @default(OTHER)

  fileName     String
  originalName String?
  fileUrl      String
  publicId     String?

  mimeType     String?
  extension    String?
  fileSize     Int?

  remarks      String?

  uploadedById String?

  uploadedAt   DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  allocation   Allocation   @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])

  @@index([allocationId])
  @@index([type])
}

model Exporter {
  id            String       @id @default(cuid())
  name          String
  address       String?
  phone         String?
  email         String?
  contactPerson String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  allocations   Allocation[]
  shipments     Shipment[]
}

model Consignee {
  id              String        @id @default(cuid())
  name            String
  contactPerson   String?
  address         String?
  phone           String?
  email           String?
  transporter     String?
  placeOfLoading  String
  transitRoute    String
  portOfDischarge String
  transportMode   TransportMode
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  allocations     Allocation[]
  shipments       Shipment[]
}

model Shipment {
  id                String         @id @default(cuid())
  shipmentNumber    String         @unique
  shipmentDate      DateTime
  xfNumber          String?
  nxpNumber         String?
  cciNumber         String?
  eNumber           String?
  bookingNumber     String?
  transportMode     TransportMode
  shippingLine      String?
  vesselName        String?
  voyageNumber      String?
  portOfLoading     String?
  portOfDischarge   String?
  expectedDeparture DateTime?
  expectedArrival   DateTime?
  actualDeparture   DateTime?
  actualArrival     DateTime?
  remarks           String?
  status            ShipmentStatus @default(DRAFT)
  clientId          String
  exporterId        String
  consigneeId       String
  createdById       String
  allocationId      String?        @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  containers        Container[]
  documents         Document[]
  invoice           Invoice?
  packingList       PackingList?
  allocation        Allocation?    @relation(fields: [allocationId], references: [id])
  client            Client         @relation(fields: [clientId], references: [id])
  consignee         Consignee      @relation(fields: [consigneeId], references: [id])
  createdBy         User           @relation(fields: [createdById], references: [id])
  exporter          Exporter       @relation(fields: [exporterId], references: [id])
  transits          Transit[]

  @@index([shipmentDate])
  @@index([status])
  @@index([transportMode])
  @@index([clientId])
  @@index([exporterId])
  @@index([consigneeId])
}

model Invoice {
  id                  String        @id @default(cuid())
  shipmentId          String        @unique
  invoiceNumber       String        @unique
   // Invoice number supplied by the client/vendor
  externalInvoiceNumber String?
  invoiceDate         DateTime
  currency            Currency
  exchangeRate        Decimal?      @db.Decimal(18, 4)
  status              InvoiceStatus @default(UNPAID)
  paymentTerms        PaymentTerms?
  incoterm            String?
  commercialReference String?
  transportUnits      Int?
  freight             Decimal       @db.Decimal(18, 2)
  subtotal            Decimal       @db.Decimal(18, 2)
  totalAmount         Decimal       @db.Decimal(18, 2)
  remarks             String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  documents           Document[]
  
  shipment            Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  items               InvoiceItem[]

  @@index([invoiceDate])
  @@index([status])
  @@index([currency])
}

model Container {
  id                 String          @id @default(cuid())
  shipmentId         String
  packingListId      String?
  containerNumber    String          @unique
  sealNumber         String?
  containerType      ContainerType
  containerSize      ContainerSize
  grossWeight        Decimal?        @db.Decimal(18, 2)
  netWeight          Decimal?        @db.Decimal(18, 2)
  tareWeight         Decimal?        @db.Decimal(18, 2)
  volume             Decimal?        @db.Decimal(18, 2)
  loadingLocation    String?
  destination        String?
  status             ContainerStatus @default(EMPTY)
  shippingLine       String?
  bookingReference   String?
  containerCondition String?
    // Terminal Charges
  terminalChargeStatus   TerminalChargeStatus @default(UNPAID)
  terminalChargeAmount   Decimal?             @db.Decimal(18, 2)
  terminalChargeCurrency Currency?
  terminalChargePaidAt   DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  packingList        PackingList?    @relation(fields: [packingListId], references: [id])
  shipment           Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  documents          Document[]
  transits           Transit[]
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  hsCode      String?
  packageType String?
  packages    Int?
  grossWeight Decimal? @db.Decimal(18, 2)
  netWeight   Decimal? @db.Decimal(18, 2)
  quantity    Decimal  @db.Decimal(18, 2)
  unit        String?
  unitPrice   Decimal  @db.Decimal(18, 2)
  total       Decimal  @db.Decimal(18, 2)
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([hsCode])
}

model PackingList {
  id                String            @id @default(cuid())
  shipmentId        String            @unique
  packingListNumber String            @unique
  packingDate       DateTime
  packageType       String?
  totalPackages     Int?
  grossWeight       Decimal           @db.Decimal(18, 2)
  netWeight         Decimal           @db.Decimal(18, 2)
  marksAndNumbers   String?
  remarks           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  containers        Container[]
  documents         Document[]
  shipment          Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  items             PackingListItem[]
}

model PackingListItem {
  id            String      @id @default(cuid())
  packingListId String
  description   String
  packageType   String?
  packages      Int?
  grossWeight   Decimal?    @db.Decimal(18, 2)
  netWeight     Decimal?    @db.Decimal(18, 2)
  remarks       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  packingList   PackingList @relation(fields: [packingListId], references: [id], onDelete: Cascade)
}

model Transit {
  id             String        @id @default(cuid())
  transitNumber  String        @unique
  shipmentId     String
  containerId    String
  origin         String
  destination    String
  transportMode  TransportMode
  transporter    String?
  transitInvoice String?
  agentNumber    String?
  exporterNumber String?
  wibNumber      String?
  quantity       Decimal?      @db.Decimal(18, 2)
  description    String?
  unitPrice      Decimal?      @db.Decimal(18, 2)
  totalPrice     Decimal?      @db.Decimal(18, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  documents      Document[]
  container      Container     @relation(fields: [containerId], references: [id])
  shipment       Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model Allocation {
  id                   String               @id @default(cuid())
  allocationNumber     String               @unique
  clientId             String
  exporterId           String?
  consigneeId          String?
  serviceType          ServiceType
  priority             AllocationPriority   @default(MEDIUM)
  status               AllocationStatus     @default(PENDING)
  cargoDescription     String
  cargoType            String?
  commodityCode        String?
  commodityName        String?
  quantity             Decimal?             @db.Decimal(18, 2)
  packageType          String?
  numberOfPackages     Int?
  grossWeight          Decimal?             @db.Decimal(18, 2)
  netWeight            Decimal?             @db.Decimal(18, 2)
  volume               Decimal?             @db.Decimal(18, 2)
  originCountry        String?
  originCity           String?
  pickupAddress        String?
  pickupDate           DateTime?
  destinationCountry   String
  destinationCity      String?
  portOfLoading        String?
  portOfDischarge      String?
  transportMode        TransportMode?
  shippingLine         String?
  incoterm             String?
  deliveryAddress      String?
  expectedShipmentDate DateTime?
  estimatedValue       Decimal?             @db.Decimal(18, 2)
  currency             String?
  paymentTerms         String?
  freightType          String?
  insuranceRequired    Boolean              @default(false)
  specialInstruction   String?
  internalRemark       String?
  destinationPort      String?
  createdById          String
  assignedToId         String?
  approvedById         String?
  assignedAt           DateTime?
  approvedAt           DateTime?
  completedAt          DateTime?
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  approvedBy           User?                @relation("ApprovedAllocations", fields: [approvedById], references: [id])
  assignedTo           User?                @relation("AssignedAllocations", fields: [assignedToId], references: [id])
  client               Client               @relation(fields: [clientId], references: [id])
  consignee            Consignee?           @relation(fields: [consigneeId], references: [id])
  createdBy            User                 @relation("CreatedAllocations", fields: [createdById], references: [id])
  exporter             Exporter?            @relation(fields: [exporterId], references: [id])
  documents            AllocationDocument[]
  attachedDocuments    Document[]
  shipment             Shipment?

  @@index([clientId])
  @@index([exporterId])
  @@index([consigneeId])
  @@index([status])
  @@index([priority])
  @@index([serviceType])
  @@index([createdById])
  @@index([assignedToId])
  @@index([approvedById])
  @@index([expectedShipmentDate])
  @@index([createdAt])
}

model Client {
  id             String       @id @default(cuid())
  clientCode     String       @unique
  companyName    String
  clientType     ClientType   @default(COMPANY)
  contactPerson  String?
  email          String?
  phone          String?
  alternatePhone String?
  address        String?
  city           String?
  state          String?
  country        String?
  website        String?
  taxNumber      String?
  remarks        String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  allocations    Allocation[]
  shipments      Shipment[]
}

model Document {
  id            String       @id @default(cuid())

  type          DocumentType

  fileName      String
  originalName  String?
  fileUrl       String
  publicId      String?

  mimeType      String?
  fileSize      Int?
  remarks       String?

  allocationId  String?
  shipmentId    String?
  containerId   String?
  invoiceId     String?
  packingListId String?
  transitId     String?

  uploadedAt    DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  allocation    Allocation?  @relation(fields: [allocationId], references: [id])
  container     Container?   @relation(fields: [containerId], references: [id])
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id])
  packingList   PackingList? @relation(fields: [packingListId], references: [id])
  shipment      Shipment?    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  transit       Transit?     @relation(fields: [transitId], references: [id])

  @@index([shipmentId])
  @@index([containerId])
  @@index([invoiceId])
  @@index([packingListId])
  @@index([transitId])
}

enum TerminalChargeStatus {
  UNPAID
  PAID
  WAIVED
}
enum Role {
  ADMIN
  CLIENT
  STAFF
  OFFICER
  VIEWER
}

enum ClientType {
  COMPANY
  INDIVIDUAL
}

enum AllocationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AllocationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ServiceType {
  EXPORT_DOCUMENTATION
  CUSTOMS_CLEARANCE
  FREIGHT_FORWARDING
  HAULAGE
  CONTAINER_BOOKING
  INSPECTION
  WAREHOUSING
  INSURANCE
  OTHER
}

enum ContainerType {
  DRY
  REEFER
  OPEN_TOP
  FLAT_RACK
  TANK
}

enum ContainerSize {
  FT20
  FT40
  FT40_HC
  FT45
}

enum ContainerStatus {
  EMPTY
  LOADED
  IN_TRANSIT
  DELIVERED
}

enum ShipmentStatus {
  DRAFT
  READY
  BOOKED
  LOADED
  IN_TRANSIT
  ARRIVED
  CUSTOMS_CLEARANCE
  DELIVERED
  COMPLETED
  CANCELLED
}

enum TransportMode {
  ROAD
  SEA
  AIR
  RAIL
}

enum DocumentType {
  COMMERCIAL_INVOICE
  PACKING_LIST
  BILL_OF_LADING
  NXP
  XF
  CCI
  E_NUMBER
  INSURANCE
  INSPECTION_CERTIFICATE
  EXPORT_PERMIT
  CONTAINER_DOCUMENT
  TERMINAL_PAYMENT_RECEIPT
  TRANSIT_INVOICE
  OTHER
}
enum Currency {
  NGN
  USD
  EUR
}

enum PaymentTerms {
  CASH
  ADVANCE
  COD
  NET_15
  NET_30
  NET_60
  LETTER_OF_CREDIT
}

enum InvoiceStatus {
  UNPAID
  DRAFT
  SENT
  APPROVED
  PAID
  CANCELLED
}
