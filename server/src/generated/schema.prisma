generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  role     Role    @default(STAFF)
  isActive Boolean @default(true)

  // Profile
  phone      String?
  department String?
  jobTitle   String?
  avatar     String?

  shipments           Shipment[]
  rateCards           RateCard[]           @relation("RateCardCreator")
  permissions         UserPermission[]
  createdAllocations  Allocation[]         @relation("CreatedAllocations")
  assignedAllocations Allocation[]         @relation("AssignedAllocations")
  approvedAllocations Allocation[]         @relation("ApprovedAllocations")
  uploadedDocuments   AllocationDocument[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  quoteMessages      QuoteMessage[]
  quoteAttachments   QuoteAttachment[]
  quoteNotifications QuoteNotification[]
  quoteAuditEvents   QuoteAuditEvent[]
  quoteSubmissions   QuoteSubmission[]   @relation("ExporterQuoteSubmissions")
}

model AllocationDocument {
  id String @id @default(cuid())

  allocationId String

  type DocumentType @default(OTHER)

  fileName     String
  originalName String?
  fileUrl      String
  publicId     String?

  mimeType  String?
  extension String?
  fileSize  Int?

  remarks String?

  uploadedById String?

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  allocation Allocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([allocationId])
  @@index([type])
}

model Exporter {
  id            String       @id @default(cuid())
  name          String
  address       String?
  phone         String?
  email         String?
  contactPerson String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  documents     Document[]
  allocations   Allocation[]
  shipments     Shipment[]
}

model Consignee {
  id              String        @id @default(cuid())
  name            String
  contactPerson   String?
  address         String?
  phone           String?
  email           String?
  transporter     String?
  placeOfLoading  String
  transitRoute    String
  portOfDischarge String
  transportMode   TransportMode
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  allocations     Allocation[]
  shipments       Shipment[]
  documents       Document[]
}

model Shipment {
  id                String         @id @default(cuid())
  shipmentNumber    String         @unique
  shipmentDate      DateTime
  xfNumber          String?
  nxpNumber         String?
  cciNumber         String?
  eNumber           String?
  bookingNumber     String?
  transportMode     TransportMode
  shippingLine      String?
  vesselName        String?
  voyageNumber      String?
  portOfLoading     String?
  portOfDischarge   String?
  expectedDeparture DateTime?
  expectedArrival   DateTime?
  actualDeparture   DateTime?
  actualArrival     DateTime?
  remarks           String?
  status            ShipmentStatus @default(DRAFT)
  clientId          String
  exporterId        String
  consigneeId       String
  createdById       String
  allocationId      String?        @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  containers        Container[]
  documents         Document[]
  invoices          Invoice[]
  packingList       PackingList?
  allocation        Allocation?    @relation(fields: [allocationId], references: [id])
  client            Client         @relation(fields: [clientId], references: [id])
  consignee         Consignee      @relation(fields: [consigneeId], references: [id])
  createdBy         User           @relation(fields: [createdById], references: [id])
  exporter          Exporter       @relation(fields: [exporterId], references: [id])
  transits          Transit[]

  @@index([shipmentDate])
  @@index([status])
  @@index([transportMode])
  @@index([clientId])
  @@index([exporterId])
  @@index([consigneeId])
}

model Invoice {
  id                    String           @id @default(cuid())
  shipmentId            String
  invoiceNumber         String           @unique
  // Invoice number supplied by the client/vendor
  externalInvoiceNumber String?
  invoiceDate           DateTime
  currency              Currency
  exchangeRate          Decimal?         @db.Decimal(18, 4)
  status                InvoiceStatus    @default(UNPAID)
  paymentTerms          PaymentTerms?
  incoterm              String?
  commercialReference   String?
  transportUnits        Int?
  freight               Decimal          @db.Decimal(18, 2)
  subtotal              Decimal          @db.Decimal(18, 2)
  totalAmount           Decimal          @db.Decimal(18, 2)
  remarks               String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  documents             Document[]
  payments              InvoicePayment[]

  shipment Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  items    InvoiceItem[]

  @@index([invoiceDate])
  @@index([status])
  @@index([currency])
}

model Container {
  id                     String               @id @default(cuid())
  shipmentId             String
  packingListId          String?
  containerNumber        String               @unique
  sealNumber             String?
  containerType          ContainerType
  containerSize          ContainerSize
  grossWeight            Decimal?             @db.Decimal(18, 2)
  netWeight              Decimal?             @db.Decimal(18, 2)
  tareWeight             Decimal?             @db.Decimal(18, 2)
  volume                 Decimal?             @db.Decimal(18, 2)
  loadingLocation        String?
  destination            String?
  status                 ContainerStatus      @default(EMPTY)
  shippingLine           String?
  bookingReference       String?
  containerCondition     String?
  // Terminal Charges
  terminalChargeStatus   TerminalChargeStatus @default(UNPAID)
  terminalChargeAmount   Decimal?             @db.Decimal(18, 2)
  terminalChargeCurrency Currency?
  terminalChargePaidAt   DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  packingList            PackingList?         @relation(fields: [packingListId], references: [id])
  shipment               Shipment             @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  documents              Document[]
  transits               Transit[]
  gateMovements          GateMovement[]
}

model InvoiceItem {
  id          String           @id @default(cuid())
  invoiceId   String
  description String
  hsCode      String?
  packageType String?
  packages    Int?
  grossWeight Decimal?         @db.Decimal(18, 2)
  netWeight   Decimal?         @db.Decimal(18, 2)
  quantity    Decimal          @db.Decimal(18, 2)
  unit        String?
  unitPrice   Decimal          @db.Decimal(18, 2)
  total       Decimal          @db.Decimal(18, 2)
  itemDate    DateTime?
  remarks     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  invoice     Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payments    InvoicePayment[]

  @@index([invoiceId])
  @@index([hsCode])
}

model PackingList {
  id                String            @id @default(cuid())
  shipmentId        String            @unique
  packingListNumber String            @unique
  packingDate       DateTime
  packageType       String?
  totalPackages     Int?
  grossWeight       Decimal           @db.Decimal(18, 2)
  netWeight         Decimal           @db.Decimal(18, 2)
  marksAndNumbers   String?
  remarks           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  containers        Container[]
  documents         Document[]
  shipment          Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  items             PackingListItem[]
}

model PackingListItem {
  id            String      @id @default(cuid())
  packingListId String
  description   String
  packageType   String?
  packages      Int?
  grossWeight   Decimal?    @db.Decimal(18, 2)
  netWeight     Decimal?    @db.Decimal(18, 2)
  remarks       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  itemDate      DateTime?
  packingList   PackingList @relation(fields: [packingListId], references: [id], onDelete: Cascade)
}

model Transit {
  id             String        @id @default(cuid())
  transitNumber  String        @unique
  shipmentId     String
  containerId    String
  origin         String
  destination    String
  transportMode  TransportMode
  transporter    String?
  transitInvoice String?
  agentNumber    String?
  exporterNumber String?
  wibNumber      String?
  quantity       Decimal?      @db.Decimal(18, 2)
  description    String?
  unitPrice      Decimal?      @db.Decimal(18, 2)
  totalPrice     Decimal?      @db.Decimal(18, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  documents      Document[]
  container      Container     @relation(fields: [containerId], references: [id])
  shipment       Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model Allocation {
  id                   String               @id @default(cuid())
  allocationNumber     String               @unique
  clientId             String
  exporterId           String?
  consigneeId          String?
  serviceType          ServiceType
  priority             AllocationPriority   @default(MEDIUM)
  status               AllocationStatus     @default(PENDING)
  cargoDescription     String
  cargoType            String?
  commodityCode        String?
  commodityName        String?
  quantity             Decimal?             @db.Decimal(18, 2)
  packageType          String?
  numberOfPackages     Int?
  grossWeight          Decimal?             @db.Decimal(18, 2)
  netWeight            Decimal?             @db.Decimal(18, 2)
  volume               Decimal?             @db.Decimal(18, 2)
  originCountry        String?
  originCity           String?
  pickupAddress        String?
  pickupDate           DateTime?
  destinationCountry   String
  destinationCity      String?
  portOfLoading        String?
  portOfDischarge      String?
  transportMode        TransportMode?
  shippingLine         String?
  incoterm             String?
  deliveryAddress      String?
  expectedShipmentDate DateTime?
  estimatedValue       Decimal?             @db.Decimal(18, 2)
  currency             String?
  paymentTerms         String?
  freightType          String?
  insuranceRequired    Boolean              @default(false)
  specialInstruction   String?
  internalRemark       String?
  destinationPort      String?
  createdById          String
  assignedToId         String?
  approvedById         String?
  assignedAt           DateTime?
  approvedAt           DateTime?
  completedAt          DateTime?
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  approvedBy           User?                @relation("ApprovedAllocations", fields: [approvedById], references: [id])
  assignedTo           User?                @relation("AssignedAllocations", fields: [assignedToId], references: [id])
  client               Client               @relation(fields: [clientId], references: [id])
  consignee            Consignee?           @relation(fields: [consigneeId], references: [id])
  createdBy            User                 @relation("CreatedAllocations", fields: [createdById], references: [id])
  exporter             Exporter?            @relation(fields: [exporterId], references: [id])
  documents            AllocationDocument[]
  attachedDocuments    Document[]
  shipment             Shipment?

  @@index([clientId])
  @@index([exporterId])
  @@index([consigneeId])
  @@index([status])
  @@index([priority])
  @@index([serviceType])
  @@index([createdById])
  @@index([assignedToId])
  @@index([approvedById])
  @@index([expectedShipmentDate])
  @@index([createdAt])
}

model Client {
  id             String       @id @default(cuid())
  clientCode     String       @unique
  companyName    String
  clientType     ClientType   @default(COMPANY)
  contactPerson  String?
  email          String?
  phone          String?
  alternatePhone String?
  address        String?
  city           String?
  state          String?
  country        String?
  website        String?
  taxNumber      String?
  remarks        String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  allocations    Allocation[]
  shipments      Shipment[]
  documents      Document[]
}

model Document {
  id String @id @default(cuid())

  type DocumentType

  fileName     String
  originalName String?
  fileUrl      String
  publicId     String?

  mimeType String?
  fileSize Int?
  remarks  String?

  allocationId  String?
  shipmentId    String?
  containerId   String?
  invoiceId     String?
  packingListId String?
  transitId     String?

  clientId    String?
  exporterId  String?
  consigneeId String?

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client    Client?    @relation(fields: [clientId], references: [id])
  exporter  Exporter?  @relation(fields: [exporterId], references: [id])
  consignee Consignee? @relation(fields: [consigneeId], references: [id])

  allocation  Allocation?  @relation(fields: [allocationId], references: [id])
  container   Container?   @relation(fields: [containerId], references: [id])
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
  packingList PackingList? @relation(fields: [packingListId], references: [id])
  shipment    Shipment?    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  transit     Transit?     @relation(fields: [transitId], references: [id])

  @@index([shipmentId])
  @@index([containerId])
  @@index([invoiceId])
  @@index([packingListId])
  @@index([transitId])
}

enum TerminalChargeStatus {
  UNPAID
  PAID
  WAIVED
}

enum Role {
  ADMIN
  CLIENT
  STAFF
  OFFICER
  VIEWER
  EXPORTER
}

enum ClientType {
  COMPANY
  INDIVIDUAL
}

enum AllocationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AllocationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ServiceType {
  EXPORT_DOCUMENTATION
  CUSTOMS_CLEARANCE
  FREIGHT_FORWARDING
  HAULAGE
  CONTAINER_BOOKING
  INSPECTION
  WAREHOUSING
  INSURANCE
  OTHER
}

enum ContainerType {
  DRY
  REEFER
  OPEN_TOP
  FLAT_RACK
  TANK
}

enum ContainerSize {
  FT20
  FT40
  FT40_HC
  FT45
}

enum ContainerStatus {
  EMPTY
  LOADED
  IN_TRANSIT
  DELIVERED
}

enum ShipmentStatus {
  DRAFT
  READY
  BOOKED
  LOADED
  IN_TRANSIT
  ARRIVED
  CUSTOMS_CLEARANCE
  DELIVERED
  COMPLETED
  CANCELLED
}

enum TransportMode {
  ROAD
  SEA
  AIR
  RAIL
}

enum DocumentType {
  COMMERCIAL_INVOICE
  PACKING_LIST
  BILL_OF_LADING
  NXP
  XF
  CCI
  E_NUMBER
  INSURANCE
  INSPECTION_CERTIFICATE
  EXPORT_PERMIT
  CONTAINER_DOCUMENT
  TERMINAL_PAYMENT_RECEIPT
  TRANSIT_INVOICE
  OTHER
}

enum Currency {
  NGN
  USD
  EUR
  CFA
}

enum PaymentTerms {
  CASH
  ADVANCE
  COD
  NET_15
  NET_30
  NET_60
  LETTER_OF_CREDIT
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  DRAFT
  SENT
  APPROVED
  PAID
  CANCELLED
}

enum GateType {
  TERMINAL_GATE
  ECOWAS_GATE
}

enum GateMovementStatus {
  PENDING
  CLEARED
  CROSSED
  CANCELLED
}

enum Permission {
  VIEW_DASHBOARD

  VIEW_CLIENTS
  CREATE_CLIENT
  EDIT_CLIENT
  DELETE_CLIENT

  VIEW_EXPORTERS
  CREATE_EXPORTER
  EDIT_EXPORTER
  DELETE_EXPORTER

  VIEW_CONSIGNEES
  CREATE_CONSIGNEE
  EDIT_CONSIGNEE
  DELETE_CONSIGNEE

  VIEW_SHIPMENTS
  CREATE_SHIPMENT
  EDIT_SHIPMENT
  DELETE_SHIPMENT

  VIEW_ALLOCATIONS
  CREATE_ALLOCATION
  EDIT_ALLOCATION
  DELETE_ALLOCATION

  VIEW_INVOICES
  CREATE_INVOICE
  EDIT_INVOICE
  DELETE_INVOICE

  VIEW_PACKING_LISTS
  CREATE_PACKING_LIST
  EDIT_PACKING_LIST
  DELETE_PACKING_LIST

  VIEW_CONTAINERS
  CREATE_CONTAINER
  EDIT_CONTAINER
  DELETE_CONTAINER

  VIEW_TRANSITS
  CREATE_TRANSIT
  EDIT_TRANSIT
  DELETE_TRANSIT

  VIEW_DOCUMENTS
  UPLOAD_DOCUMENT
  DELETE_DOCUMENT
  EDIT_DOCUMENT

  VIEW_USERS
  CREATE_USER
  EDIT_USER
  DELETE_USER

  MANAGE_PERMISSIONS

  VIEW_RATE_CARDS
  MANAGE_RATE_CARDS
  ACTIVATE_RATE_CARDS
  MANAGE_QUOTE_SETTINGS
  VIEW_ALL_QUOTES
  REVIEW_QUOTE
  APPROVE_QUOTE

  VIEW_GATES
  CREATE_GATE
  EDIT_GATE
  DELETE_GATE

  VIEW_OWN_QUOTES
  CREATE_QUOTE
  REQUEST_QUOTE_CHANGES
  REJECT_QUOTE
  MANAGE_QUOTE_ASSIGNMENTS
  UPLOAD_QUOTE_ATTACHMENT
  ADD_QUOTE_MESSAGE
  PRINT_QUOTE
  ACCEPT_QUOTE
  DECLINE_QUOTE
  COMPLETE_QUOTE
  REVIEW_QUOTATIONS

  MANAGE_QUOTE_CHARGES
}

enum QuoteSubmissionItemType {
  SERVICE
  CUSTOMS_CHARGE
  TRANSPORT_CHARGE
}

model UserPermission {
  id String @id @default(cuid())

  userId     String
  permission Permission

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

model InvoicePayment {
  id String @id @default(cuid())

  invoiceId     String
  invoiceItemId String?

  amount        Decimal  @db.Decimal(18, 2)
  description   String?
  paymentDate   DateTime @default(now())
  paymentMethod String?
  reference     String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceItem InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([invoiceItemId])
}

model GateMovement {
  id String @id @default(cuid())

  containerId String?
  container   Container? @relation(fields: [containerId], references: [id])

  containerNumber String
  yardStoreNumber String?

  truckFrontPlate String
  truckBackPlate  String

  gateType GateType

  status GateMovementStatus @default(PENDING)

  crossedAt DateTime?
  clearedAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([containerId])
  @@index([containerNumber])
  @@index([gateType])
  @@index([status])
  @@index([createdAt])
}

enum QuoteMode {
  AIR
  LAND
  SEA
}

enum QuoteDirection {
  IMPORT
  EXPORT
}

enum QuoteStatus {
  CALCULATED
  PENDING_REVIEW
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum RateCardStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RateCalculationType {
  FIXED
  WEIGHT_SLAB
  PERCENTAGE
  PER_UNIT
  VARIABLE
}

enum CalculationBasis {
  SUBTOTAL
  CUSTOMS_VALUE
  FREIGHT_AMOUNT
}

enum QuoteSource {
  GUEST
  ACCOUNT
}

model RateCard {
  id        String         @id @default(cuid())
  name      String
  mode      QuoteMode
  direction QuoteDirection
  status    RateCardStatus @default(DRAFT)
  currency  String         @default("NGN")

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("RateCardCreator", fields: [createdById], references: [id])

  components     RateComponent[]
  weightSlabs    WeightSlab[]
  notes          RateCardNote[]
  configurations RateCardConfiguration[]
  quotes         Quote[]                 @relation("QuoteRateCard")

  @@unique([name, mode, direction, effectiveFrom])
  @@index([mode, direction, status])
  @@index([effectiveFrom, effectiveTo])
  @@index([createdById])
}

model RateComponent {
  id               String              @id @default(cuid())
  rateCardId       String
  name             String
  code             String?
  calculationType  RateCalculationType
  calculationBasis CalculationBasis?
  unit             String?
  value            Decimal?            @db.Decimal(18, 2)
  percentage       Decimal?            @db.Decimal(18, 2)
  isActive         Boolean             @default(true)
  isOptional       Boolean             @default(false)
  isTaxable        Boolean             @default(false)
  notes            String?
  optionId         String?
  option           RateCardOption?     @relation(fields: [optionId], references: [id], onDelete: SetNull)

  pricingSectionId String?
  pricingSection   RateCardPricingSection? @relation(fields: [pricingSectionId], references: [id], onDelete: SetNull)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  configurationId String?
  configuration   RateCardConfiguration? @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  weightSlabRates WeightSlabRate[]

  @@index([optionId])
  @@index([pricingSectionId])
  @@index([rateCardId])
}

model RateCardNote {
  id         String   @id @default(cuid())
  rateCardId String
  note       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@index([rateCardId])
}

model Quote {
  id          String @id @default(cuid())
  rateCardId  String
  quoteNumber String @unique

  status QuoteStatus @default(PENDING_REVIEW)
  source QuoteSource @default(GUEST)

  // Customer information
  customerName String?
  email        String?
  phone        String?

  // Shipment information
  weightKg         Decimal? @db.Decimal(12, 3)
  goodsDescription String?
  hsCode           String?
  customsValue     Decimal? @db.Decimal(18, 2)
  freightAmount    Decimal? @db.Decimal(18, 2)
  quantity         Decimal? @db.Decimal(12, 3)

  // Quotation totals
  currency    String   @default("NGN")
  subtotal    Decimal? @db.Decimal(18, 2)
  totalAmount Decimal? @db.Decimal(18, 2)

  // Historical pricing records
  inputSnapshot   Json?
  pricingSnapshot Json?

  // Review and validity
  requiresReview Boolean             @default(false)
  validUntil     DateTime?
  notes          String?
  segments       QuoteSegment[]      @relation("QuoteSegmentQuote")
  submissions    QuoteSubmission[]
  messages       QuoteMessage[]
  attachments    QuoteAttachment[]
  notifications  QuoteNotification[]
  auditEvents    QuoteAuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rateCard RateCard @relation("QuoteRateCard", fields: [rateCardId], references: [id], onDelete: Restrict)

  items QuoteItem[] @relation("QuoteItems")

  @@index([rateCardId])
  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model WeightSlab {
  id         String @id @default(cuid())
  rateCardId String

  label       String
  minWeightKg Decimal  @db.Decimal(12, 3)
  maxWeightKg Decimal? @db.Decimal(12, 3)

  displayOrder Int @default(0)

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  rates    WeightSlabRate[]
  optionId String?
  option   RateCardOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)

  pricingSectionId String?
  pricingSection   RateCardPricingSection? @relation(fields: [pricingSectionId], references: [id], onDelete: SetNull)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  configurationId String?
  configuration   RateCardConfiguration? @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@index([optionId, minWeightKg])
  @@index([pricingSectionId, minWeightKg])
  @@index([rateCardId, minWeightKg])
}

model WeightSlabRate {
  id           String @id @default(cuid())
  weightSlabId String
  componentId  String

  amount Decimal @db.Decimal(18, 2)

  weightSlab WeightSlab    @relation(fields: [weightSlabId], references: [id], onDelete: Cascade)
  component  RateComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weightSlabId, componentId])
  @@index([componentId])
}

model QuoteItem {
  id         String  @id @default(cuid())
  quoteId    String
  exporterId String?

  // Optional reference to the original charge.
  // The snapshot remains usable if the charge is later removed.
  componentId String?

  // Historical charge information
  componentName    String
  componentCode    String?
  calculationType  RateCalculationType
  calculationBasis CalculationBasis?
  unit             String?
  submissions      QuoteSubmissionItem[]

  // Values used during calculation
  rateApplied Decimal @db.Decimal(18, 4)
  quantity    Decimal @default(1) @db.Decimal(12, 3)
  lineTotal   Decimal @db.Decimal(18, 2)

  // Review information
  isEstimate     Boolean @default(false)
  requiresReview Boolean @default(false)
  remarks        String?

  createdAt DateTime @default(now())

  quote     Quote         @relation("QuoteItems", fields: [quoteId], references: [id], onDelete: Cascade)
  segmentId String?
  segment   QuoteSegment? @relation("QuoteSegmentItems", fields: [segmentId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([componentId])
}

enum QuoteSubmissionStatus {
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum QuoteMessageSenderType {
  EXPORTER
  ADMIN
}

enum QuoteAuditAction {
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  WORK_STARTED
  COMPLETED
  ARCHIVED
  REOPENED
  CHARGES_UPDATED
}

model QuoteSubmission {
  id String @id @default(cuid())

  quoteId    String
  exporterId String?

  // Guest or authenticated exporter details
  customerName String?
  email        String?
  phone        String?

  status QuoteSubmissionStatus @default(PENDING_REVIEW)

  // Snapshot of the services and prices submitted for review
  currency    String  @default("NGN")
  subtotal    Decimal @default(0) @db.Decimal(18, 2)
  taxAmount   Decimal @default(0) @db.Decimal(18, 2)
  totalAmount Decimal @default(0) @db.Decimal(18, 2)

  customerMessage String?
  adminMessage    String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  approvedAt  DateTime?
  completedAt DateTime?
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote                    Quote                 @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  exporter                 User?                 @relation("ExporterQuoteSubmissions", fields: [exporterId], references: [id], onDelete: SetNull)
  items                    QuoteSubmissionItem[]
  messages                 QuoteMessage[]
  attachments              QuoteAttachment[]
  auditEvents              QuoteAuditEvent[]
  customsChargeRequested   Boolean               @default(false)
  invoiceValue             Decimal?              @db.Decimal(18, 2)
  invoiceCurrency          String?
  transportChargeRequested Boolean               @default(false)

  // Frozen VAT policy from the original quote. It is reused when operations adds charges.
  vatEnabled    Boolean @default(false)
  vatPercentage Decimal @default(0) @db.Decimal(7, 4)

  @@index([quoteId, createdAt])
  @@index([status, createdAt])
  @@index([email])
}

model QuoteSubmissionItem {
  id String @id @default(cuid())

  itemType QuoteSubmissionItemType @default(SERVICE)

  submissionId String

  // Original charge reference; snapshots remain usable independently
  quoteItemId String?

  componentName String
  componentCode String?

  quantity    Decimal @default(1) @db.Decimal(12, 3)
  rateApplied Decimal @db.Decimal(18, 4)
  lineTotal   Decimal @db.Decimal(18, 2)

  // Records both selected and unselected original charges
  isSelected Boolean @default(false)

  createdAt DateTime @default(now())

  submission QuoteSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  quoteItem  QuoteItem?      @relation(fields: [quoteItemId], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@index([quoteItemId])
}

model QuoteMessage {
  id String @id @default(cuid())

  quoteId      String
  submissionId String?

  senderType   QuoteMessageSenderType
  senderUserId String?

  message String

  createdAt DateTime @default(now())

  quote      Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  submission QuoteSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  sender     User?            @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  attachments QuoteAttachment[]

  @@index([quoteId, createdAt])
  @@index([submissionId, createdAt])
}

model QuoteAttachment {
  id String @id @default(cuid())

  quoteId      String
  submissionId String?
  messageId    String?

  uploadedById   String?
  uploadedByType QuoteMessageSenderType

  fileName     String
  originalName String?
  fileUrl      String
  publicId     String?
  mimeType     String?
  fileSize     Int?

  remarks   String?
  createdAt DateTime @default(now())

  quote      Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  submission QuoteSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  message    QuoteMessage?    @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedBy User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([quoteId, createdAt])
  @@index([submissionId])
  @@index([messageId])
}

model QuoteNotification {
  id String @id @default(cuid())

  quoteId         String
  recipientUserId String?

  title   String
  message String
  isRead  Boolean   @default(false)
  readAt  DateTime?

  createdAt DateTime @default(now())

  quote     Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  recipient User? @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, isRead, createdAt])
  @@index([quoteId, createdAt])
}

model QuoteAuditEvent {
  id String @id @default(cuid())

  quoteId      String
  submissionId String?

  action QuoteAuditAction

  actorUserId String?
  actorType   QuoteMessageSenderType

  details   Json?
  createdAt DateTime @default(now())

  quote      Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  submission QuoteSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  actor      User?            @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([quoteId, createdAt])
  @@index([submissionId, createdAt])
}

model RateCardConfiguration {
  id         String @id @default(cuid())
  rateCardId String

  name String
  code String

  // Currency used by this configuration.
  currency String @default("NGN")

  // Optional route and equipment configuration.
  routeCode     String?
  routeLabel    String?
  equipmentType String?

  // Configuration switches.
  airlineSelectorEnabled Boolean @default(false)
  transportEnabled       Boolean @default(false)
  nafdacEnabled          Boolean @default(false)
  vatEnabled             Boolean @default(false)

  // Explicit VAT configuration.
  vatPercentage Decimal @default(7.5) @db.Decimal(5, 2)

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  // Explicit feature switches that control which inputs/calculations are required.
  weightEnabled        Boolean  @default(false)
  freightAmountEnabled Boolean  @default(false)
  customsValueEnabled  Boolean  @default(false)
  quantityEnabled      Boolean  @default(false)

  // VAT must have a deliberately selected base when enabled.
  vatCalculationBasis CalculationBasis?

  // Dynamic options and currency sections belonging to this configuration.
  options         RateCardOption[]
  pricingSections RateCardPricingSection[]
  rateCard        RateCard                 @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  components      RateComponent[]
  weightSlabs     WeightSlab[]
  airlines        RateCardAirline[]
  quoteSegments   QuoteSegment[]

  @@unique([rateCardId, code])
  @@index([rateCardId, isActive])
}

model RateCardAirline {
  id              String @id @default(cuid())
  configurationId String

  code String
  name String

  // Freight price per kilogram.
  ratePerKg Decimal @db.Decimal(18, 4)

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  configuration RateCardConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@unique([configurationId, code])
  @@index([configurationId, isActive])
}

model QuoteSegment {
  id              String  @id @default(cuid())
  quoteId         String
  configurationId String?

  name      String
  routeCode String?
  currency  String

  subtotal    Decimal @default(0) @db.Decimal(18, 2)
  taxAmount   Decimal @default(0) @db.Decimal(18, 2)
  totalAmount Decimal @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  quote Quote @relation("QuoteSegmentQuote", fields: [quoteId], references: [id], onDelete: Cascade)

  configuration RateCardConfiguration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)

  items QuoteItem[] @relation("QuoteSegmentItems")

  @@index([quoteId])
}

model RateCardOption {
  id              String   @id @default(cuid())
  configurationId String
  code            String
  name            String
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  configuration   RateCardConfiguration    @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  components      RateComponent[]
  weightSlabs     WeightSlab[]
  pricingSections RateCardPricingSection[]

  @@unique([configurationId, code])
  @@index([configurationId, isActive, displayOrder])
}

model RateCardPricingSection {
  id              String   @id @default(cuid())
  configurationId String
  optionId        String?
  code            String
  name            String
  currency        String
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  configuration RateCardConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  option        RateCardOption?       @relation(fields: [optionId], references: [id], onDelete: SetNull)
  components    RateComponent[]
  weightSlabs   WeightSlab[]

  @@unique([configurationId, code])
  @@index([configurationId, isActive, displayOrder])
  @@index([optionId])
}
